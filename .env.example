# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://postgres:xxxx@xxx.railway.app:5432/railway

# Gemini (Sprint 2 — active)
GEMINI_API_KEY=your_gemini_api_key_here
# gemini-flash-latest = always-current flash line. Pin to e.g. gemini-3.5-flash if you prefer.
GEMINI_MODEL=gemini-flash-latest
# How many previous ConversationLog records to send to Gemini as context
CONTEXT_MESSAGE_LIMIT=20

# App
NODE_ENV=development
