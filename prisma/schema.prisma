// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Queue table for incoming messages from Telegram, Apple Watch, and web.
/// The local agent polls for unprocessed events and handles them.
model InboxEvent {
  id          String    @id @default(cuid())
  source      String    // "telegram" | "apple_watch" | "web"
  chatId      BigInt
  userId      BigInt?
  username    String?
  payload     Json      // Raw message payload (e.g. Telegram update object)
  processed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([processed, createdAt])
  @@map("inbox_events")
}

/// Rolling conversation memory. The agent reads the last N records for a given
/// chat to keep context across days, and appends both the user's message and
/// its own reply after every turn.
model ConversationLog {
  id        String   @id @default(cuid())
  chatId    BigInt   // Telegram chat this turn belongs to
  role      String   // "user" | "assistant"
  content   String
  intent    String?  // "workout_request" | "calorie_log" | "chat" | ... (Sprint 3+)
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
  @@map("conversation_logs")
}

/// A single body-weight reading, extracted from chat (e.g. "bugün 82 kilo
/// geldim") or added manually from the dashboard.
model WeightEntry {
  id        String   @id @default(cuid())
  weightKg  Float
  note      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("weight_entries")
}

/// A single logged food/meal entry, extracted from chat. Calories are either
/// user-stated or estimated by the coach from the description.
model CalorieEntry {
  id          String   @id @default(cuid())
  description String
  calories    Int
  macros      Json?    // {protein?, carbs?, fat?} in grams
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("calorie_entries")
}

/// A logged workout session (what was actually done, not a suggested plan),
/// extracted from chat.
model WorkoutProgram {
  id        String   @id @default(cuid())
  exercises Json     // [{name, sets, reps, notes?}]
  feedback  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("workout_programs")
}

/// Singleton row (id is always "singleton") holding a Gemini-generated summary
/// of the user's tone/exercise preferences and adherence patterns, refreshed
/// weekly by src/agent/summarize.ts and injected into every coach reply.
model StyleProfile {
  id                 String   @id @default("singleton")
  summary            Json
  onboarded          Boolean  @default(false)
  tone               String? // "samimi" | "ciddi" | "kurumsal" | "kanka"
  dailyCalorieTarget Int?
  proteinTargetG     Int?
  updatedAt          DateTime @updatedAt

  @@map("style_profiles")
}

/// A training session the coach scheduled for a given day. Distinct from
/// WorkoutProgram, which records what the user actually did.
model PlannedWorkout {
  id        String   @id @default(cuid())
  date      DateTime
  title     String // "Push A", "Bacak"
  exercises Json // [{name, sets, reps, notes?}]
  status    String   @default("planned") // planned | done | skipped
  createdAt DateTime @default(now())

  @@index([date])
  @@map("planned_workouts")
}
