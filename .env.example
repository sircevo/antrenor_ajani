# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://postgres:xxxx@xxx.railway.app:5432/railway

# Kimi (Moonshot AI) — OpenAI-compatible API at https://api.moonshot.ai/v1
KIMI_API_KEY=your_kimi_api_key_here
KIMI_MODEL=kimi-k2.6
# Optional: K3 only. K2-family models use a separate `thinking` param instead
# (see src/agent/kimi.ts) and ignore this.
# KIMI_REASONING_EFFORT=minimal

# App auth — single shared password + a random secret used to sign the session cookie.
# Generate the secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_PASSWORD=choose_a_password
AUTH_SECRET=random_hex_string
# How many previous ConversationLog records to send to the model as context
CONTEXT_MESSAGE_LIMIT=20

# App
NODE_ENV=development
